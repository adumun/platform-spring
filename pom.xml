<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>4.1.1</version>
    <relativePath/>
  </parent>

  <groupId>io.adumun.platform</groupId>
  <artifactId>platform-spring</artifactId>
  <version>0.1.0-alpha.0</version>
  <packaging>pom</packaging>

  <properties>
    <java.version>25</java.version>
    <resilience4j.version>2.4.0</resilience4j.version>

    <!-- Dependency-health tooling is pinned deliberately so evidence is reproducible. -->
    <adumun.health.maven-enforcer.version>3.6.3</adumun.health.maven-enforcer.version>
    <adumun.health.maven-dependency.version>3.11.0</adumun.health.maven-dependency.version>
    <adumun.health.maven-help.version>3.5.2</adumun.health.maven-help.version>
    <adumun.health.cyclonedx.version>2.9.3</adumun.health.cyclonedx.version>
    <adumun.health.versions-maven-plugin.version>2.21.0</adumun.health.versions-maven-plugin.version>
  </properties>

  <modules>
    <module>adumun-spring-rest</module>
    <module>adumun-spring-test</module>
    <module>adumun-spring-security</module>
    <module>adumun-spring-security-oidc</module>
    <module>adumun-spring-observability</module>
    <module>adumun-spring-resilience</module>
    <module>examples/reference-consumer</module>
  </modules>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <configuration>
          <showDeprecation>true</showDeprecation>
          <compilerArgs>
            <arg>-Xlint:deprecation</arg>
          </compilerArgs>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
